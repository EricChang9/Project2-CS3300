# Reference for future integrations; Spring Boot does NOT load this file automatically.
# Export only the values you need in your shell. None are needed for /api/health.
PORT=8080
# Future Firestore Admin SDK configuration (not connected in this scaffold):
GOOGLE_CLOUD_PROJECT=demo-roommate-expenses
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# For deployed Firestore, unset FIRESTORE_EMULATOR_HOST and use ADC.
# Future Gmail adapter credentials must be injected through a secret store.
