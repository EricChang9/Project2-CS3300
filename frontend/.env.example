# Read by Vite only; restart the dev server after changes.
# This is a server-side proxy target, never a browser credential.
API_PROXY_TARGET=http://127.0.0.1:8080
# Firebase web app configuration (public identifiers, never service-account secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
